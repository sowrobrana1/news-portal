# Copy these into each Vercel project (see DEPLOY.md).

# Supabase Postgres connection string — SAME value in both projects.
# Pooler form: postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Which brand this deployment shows: pp (প্রথম প্রহর নিউজ) or btn (BTN News)
NEXT_PUBLIC_BRAND=pp

# This site's own URL (its vercel.app domain, later the custom domain)
NEXT_PUBLIC_BASE_URL=https://prothom-prohor-news.vercel.app

# Shared secret the Facebook pipelines use to POST new stories (SAME value in both projects)
INGEST_KEY=__SET_A_RANDOM_VALUE__

# Password for /admin on the sites (SAME or different per project, your choice)
ADMIN_PASSWORD=__SET_A_PASSWORD__
